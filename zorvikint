@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600&family=Poppins:wght@400;500;600&display=swap');
@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css');
:root{--zorvikverde:#2A623D;--zorvikoro:#C4A45D}
.zorvikint00{box-sizing:border-box;width:550px;max-width:100%;margin:0 auto 34px;overflow:hidden;background:var(--dbckg4,#1a1a1a);border:1px solid var(--border1-c,#252525);border-radius:10px;box-shadow:0 8px 24px #0002;color:#aaa;font-family:"Poppins",sans-serif}
.zorvikint00 *{box-sizing:border-box}
.zorvikint01titulo{min-height:43px;padding:5px 20px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border1-c,#252525);color:var(--title,#eee);text-shadow:var(--shadow-b2);font-size:11px;font-weight:500;text-transform:lowercase}
.zorvikint01titulo b{color:var(--zorvikverde);font-weight:600}
.zorvikint02icono{width:26px;height:26px;display:grid;place-items:center;border:1px solid #c4a45d42;border-radius:50%;background:#c4a45d0b;color:var(--zorvikoro)}
.zorvikint03lista{display:grid!important;grid-template-columns:repeat(4,96px)!important;justify-content:center!important;gap:20px 22px!important;padding:30px 20px!important}
.zorvikint04miembro{position:relative!important;float:none!important;width:96px!important;height:96px!important;margin:0!important;padding:3px!important;overflow:visible!important;border:1px solid #c4a45d88!important;border-radius:50%!important;background:linear-gradient(145deg,var(--zorvikoro),var(--zorvikverde))!important;outline:0!important}
.zorvikint05foto{display:block!important;width:90px!important;height:90px!important;max-width:none!important;margin:0!important;border:2px solid var(--dbckg4,#1a1a1a)!important;border-radius:50%!important;object-fit:cover!important;transition:.35s ease!important}
.zorvikint06hover{position:absolute;inset:3px;display:grid;place-items:center;padding:10px;border-radius:50%;background:#101712e8;opacity:0;transform:scale(.88);transition:.3s ease;text-align:center}
.zorvikint04miembro:hover .zorvikint05foto,.zorvikint04miembro:focus .zorvikint05foto{filter:blur(2px) brightness(.45);transform:scale(1.04)}
.zorvikint04miembro:hover .zorvikint06hover,.zorvikint04miembro:focus .zorvikint06hover{opacity:1;transform:scale(1)}
.zorvikint07nombre{color:var(--title,#fff);font:600 9px/1.35 "Poppins",sans-serif}.zorvikint07nombre small{display:block;margin-top:4px;color:var(--zorvikoro);font:600 7px "Cinzel",serif;text-transform:uppercase;letter-spacing:.5px}
.zorvikint08rango{position:absolute;right:-2px;bottom:2px;width:22px;height:22px;display:grid!important;place-items:center;border:2px solid var(--dbckg4,#1a1a1a);border-radius:50%;background:var(--zorvikverde);color:var(--zorvikoro);font-size:8px;z-index:2}
.zorvikint09presidenta{box-shadow:0 0 0 2px #c4a45d33,0 0 16px #c4a45d22}
@media(max-width:520px){.zorvikint03lista{grid-template-columns:repeat(4,96px)!important;gap:14px 10px!important;padding:25px 8px!important;min-width:438px}.zorvikint00{overflow-x:auto}}
